{
  "extends": "@ember/app-tsconfig",
  "compilerOptions": {
    "skipLibCheck": true,
    "types": [
      "unplugin-icons/types/ember"
    ],
    "paths": {
      "test-app/tests/*": [
        "./tests/*"
      ],
      "test-app/*": [
        "./app/*"
      ],
      "*": [
        "./types/*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "tests/**/*",
    "types/**/*"
  ]
}
