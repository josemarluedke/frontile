{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "site",
    "site/lib/docfy-theme",
    "test-app"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "lint:hbs": "ember-template-lint .",
    "lint:anatomy": "node scripts/check-anatomy.mjs",
    "lint:js": "eslint .",
    "start": "pnpm --filter test-app start",
    "test": "pnpm --filter test-app test",
    "try:one": "pnpm --filter test-app try:one",
    "clean:declarations": "rm -rf packages/*/declarations",
    "clean:dist": "rm -rf packages/*/dist test-app/dist site/dist",
    "clean": "concurrently 'npm:clean:*'",
    "generate-signature-data": "pnpm --filter site generate-signature-data"
  },
  "dependencies": {
    "@ember/test-waiters": "^4.1.2",
    "@embroider/test-setup": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@glint/core": "1.5.2",
    "@glint/environment-ember-loose": "1.5.2",
    "@glint/environment-ember-template-imports": "1.5.2",
    "concurrently": "^10.0.5",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^7.9.3",
    "eslint": "^10.10.0",
    "eslint-plugin-ember": "^13.5.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.12.0",
    "lerna": "^10.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">= 10.*"
  },
  "volta": {
    "node": "26.1.0",
    "pnpm": "11.1.2"
  },
  "packageManager": "pnpm@11.1.2"
}
