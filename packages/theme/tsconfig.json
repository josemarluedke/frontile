{
  "extends": "@ember/library-tsconfig",
  "include": ["src/**/*", "unpublished-development-types/**/*"],
  "compilerOptions": {
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "rootDir": "src",
    "declaration": true,
    "declarationDir": "declarations",
    "emitDeclarationOnly": true,
    "noEmit": false
  }
}
