{
  "name": "@frontile/buttons",
  "version": "0.18.0-beta.2",
  "description": "Component Library for Ember Octane apps: Buttons",
  "keywords": [
    "ember-addon",
    "frontile"
  ],
  "repository": "https://github.com/josemarluedke/frontile",
  "license": "MIT",
  "author": "",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "files": [
    "addon-main.js",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "lint": "concurrently 'npm:lint:*(!fix)' --names 'lint:'",
    "lint:fix": "concurrently 'npm:lint:*:fix' --names 'fix:'",
    "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
    "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "concurrently 'npm:build'",
    "start": "concurrently 'npm:start:*'",
    "start:js": "rollup --config --watch --no-watch.clearScreen",
    "start:types": "glint -d --watch",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "frontile": "workspace:^"
  },
  "devDependencies": {
    "@babel/core": "7.26.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@ember/library-tsconfig": "^2.0.0",
    "@embroider/addon-dev": "8.4.0",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.11.4",
    "@glint/template": "^1.9.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^10.0.5",
    "decorator-transforms": "^2.4.0",
    "ember-source": "^7.3.0",
    "rollup": "^4.63.3",
    "rollup-plugin-copy": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@babel/runtime": ">= 7",
    "ember-source": ">= 4.12.0"
  },
  "engines": {
    "node": "10.* || >= 12"
  },
  "publishConfig": {
    "access": "public"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.js",
    "app-js": {}
  },
  "gitHead": "b8b177161d94077c43a7179e1c3fa77530a266fb"
}
